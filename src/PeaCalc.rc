#include "resource.h"
#include "windows.h"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

IDI_APPICON ICON "PeaCalc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x28L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "J.D. Schlachter / twinysam (Github)\000"
            VALUE "FileDescription", "PeaCalc - Math interpreter\000"
            VALUE "FileVersion", "v2.0.0\000"
            VALUE "InternalName", "PeaCalc\000"
            VALUE "LegalCopyright", "Original (C) 2018 J.D. Schlachter. Forked/Modified (C) 2026 twinysam (https://github.com/twinysam/PeaCalc2)\000"
            VALUE "OriginalFilename", "PeaCalc.exe\000"
            VALUE "ProductVersion", "2, 0, 0, 0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Info pop-up
//

IDD_INFOBOX DIALOGEX 0, 0, 320, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PeaCalc"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_INFO_EDIT, "RICHEDIT50W",
                    WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL |
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL,
                    7, 7, 306, 158
    DEFPUSHBUTTON   "OK", IDOK, 263, 172, 50, 14
END
